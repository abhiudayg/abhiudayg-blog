---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/JsonLd.astro';
import MermaidLoader from '../components/MermaidLoader.astro';
import PartTag from '../components/PartTag.astro';
import { BLOG_SERIES } from '../consts';
import {
	absoluteUrl,
	blogPostJsonLd,
	breadcrumbJsonLd,
	graphJsonLd,
	resolveImageUrl,
} from '../utils/seo';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, series, seriesPart, heroImage } = post.data;
const slug = post.id;
const seriesMeta = series ? BLOG_SERIES[series] : null;
const postUrl = absoluteUrl(`/blog/${slug}/`, Astro.site);
const imageUrl = resolveImageUrl(heroImage, Astro.site);
const breadcrumbItems = [
	{ name: 'Home', url: absoluteUrl('/', Astro.site) },
	{ name: 'Blog', url: absoluteUrl('/blog/', Astro.site) },
	...(seriesMeta
		? [{ name: seriesMeta.title, url: absoluteUrl(`/blog/series/${series}/`, Astro.site) }]
		: []),
	{ name: title, url: postUrl },
];
const schema = graphJsonLd(
	blogPostJsonLd({
		title,
		description,
		url: postUrl,
		image: imageUrl,
		pubDate,
		updatedDate,
		series,
	}),
	breadcrumbJsonLd(breadcrumbItems),
);
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage ?? '/og-default.jpg'}
			type="article"
			publishedTime={pubDate}
			modifiedTime={updatedDate ?? pubDate}
			section={seriesMeta?.title}
			tags={series ? [series, ...(seriesMeta ? [seriesMeta.title] : [])] : []}
		/>
		<JsonLd schema={schema} />
	</head>

	<body class="relative overflow-x-hidden">
		<!-- Subdued ambient warm radial halo -->
		<div
			class="pointer-events-none fixed top-0 left-1/2 -z-10 h-[500px] w-[900px] -translate-x-1/2 rounded-full bg-accent/5 blur-[140px]"
			aria-hidden="true"
		></div>

		<Header />
		<main class="layout-read py-10 md:py-16">
			<article itemscope itemtype="https://schema.org/BlogPosting">
				<meta itemprop="headline" content={title} />
				<meta itemprop="description" content={description} />
				<meta itemprop="datePublished" content={pubDate.toISOString()} />
				<meta itemprop="dateModified" content={(updatedDate ?? pubDate).toISOString()} />
				<link itemprop="url" href={postUrl} />
				<link itemprop="image" href={imageUrl} />

				<!-- Breadcrumb navigation -->
				<nav class="mb-6 flex flex-wrap items-center gap-1.5 font-mono text-xs text-text-muted">
					<a class="text-text-muted no-underline hover:text-accent" href="/">Home</a>
					<span>/</span>
					<a class="text-text-muted no-underline hover:text-accent" href="/blog">Blog</a>
					{seriesMeta && (
						<>
							<span>/</span>
							<a class="text-text-muted no-underline hover:text-accent" href={`/blog/series/${series}/`}>
								{seriesMeta.title}
							</a>
						</>
					)}
				</nav>

				<header class="mb-8 border-b border-border pb-6">
					<div class="flex flex-wrap items-center justify-between gap-3">
						<p class="m-0 font-mono text-[0.82rem] tracking-wide text-accent">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<span class="text-text-muted italic">
										· updated <FormattedDate date={updatedDate} />
									</span>
								)
							}
						</p>
						<div class="flex items-center gap-2">
							{seriesMeta && (
								<a class="tag-series no-underline" href={`/blog/series/${series}/`}>
									#{seriesMeta.title}
								</a>
							)}
							{seriesPart && <PartTag part={seriesPart} />}
						</div>
					</div>

					<h1 class="mt-4 font-serif text-3xl md:text-4xl lg:text-[2.6rem] font-normal leading-[1.2] text-text" itemprop="name">
						{title}
					</h1>

					<p class="mt-3 text-lg leading-relaxed text-text-muted">
						{description}
					</p>

					{
						seriesMeta && (
							<div class="mt-4 rounded border border-border bg-bg-subtle p-3 text-xs text-text-muted font-mono flex items-center justify-between">
								<span>
									Part of the <a class="text-accent underline" href={`/blog/series/${series}/`}>{seriesMeta.title}</a> series
								</span>
								<a
									class="text-accent underline"
									href={seriesMeta.repoUrl}
									target="_blank"
									rel="noopener noreferrer"
								>
									Source repo &nearr;
								</a>
							</div>
						)
					}
				</header>
				<div class="prose-content" itemprop="articleBody">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
		<MermaidLoader />
	</body>
</html>
