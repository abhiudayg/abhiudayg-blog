---
import { AUTHOR_NAME, BLOG_SERIES, REPO_URL, SITE_TITLE } from '../consts';
import SiteLogo from './SiteLogo.astro';
import SocialLinks from './SocialLinks.astro';

const today = new Date();
---

<footer class="border-t border-border bg-bg-elevated/40 pt-12 pb-16 text-text-muted">
	<div class="shell">
		<div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-12 pb-10 border-b border-border">
			<!-- Col 1: Identity & Mission -->
			<div class="space-y-3 md:col-span-5">
				<a class="inline-flex items-center transition hover:opacity-90" href="/" aria-label={`${SITE_TITLE} home`}>
					<SiteLogo size={24} />
				</a>
				<p class="text-sm leading-relaxed text-text-muted max-w-sm">
					Notes, experiments, and post-mortems from building software in public.
					Focused on systems engineering, local AI, and reliable infrastructure.
				</p>
				<p class="font-mono text-xs text-text-muted/70">
					All articles published under CC BY 4.0. Code snippets under MIT.
				</p>
			</div>

			<!-- Col 2: Navigation & Series -->
			<div class="space-y-3 md:col-span-3">
				<h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-text">Navigation</h3>
				<ul class="m-0 list-none space-y-2 p-0 text-sm font-mono">
					<li><a class="text-text-muted no-underline hover:text-accent transition" href="/">Home</a></li>
					<li><a class="text-text-muted no-underline hover:text-accent transition" href="/blog">Blog Archive</a></li>
					<li><a class="text-text-muted no-underline hover:text-accent transition" href="/about">About &amp; Work</a></li>
					<li><a class="text-text-muted no-underline hover:text-accent transition" href="/subscribe">RSS Subscription</a></li>
				</ul>
			</div>

			<!-- Col 3: Series Deep Dives -->
			<div class="space-y-3 md:col-span-4">
				<h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-text">Series Index</h3>
				<ul class="m-0 list-none space-y-2 p-0 text-sm font-mono">
					{Object.entries(BLOG_SERIES).map(([slug, s]) => (
						<li>
							<a class="text-text-muted no-underline hover:text-accent transition" href={`/blog/series/${slug}/`}>
								#{s.title}
							</a>
						</li>
					))}
				</ul>
				<div class="pt-2">
					<SocialLinks class="justify-start" />
				</div>
			</div>
		</div>

		<!-- Bottom Bar -->
		<div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 font-mono text-xs text-text-muted">
			<p class="m-0">
				&copy; {today.getFullYear()} {AUTHOR_NAME}. Building in public.
			</p>
			<p class="m-0 flex items-center gap-2">
				<span>Astro + Bun</span>
				<span>&bull;</span>
				<span>Designed with Stitch</span>
				<span>&bull;</span>
				<a class="text-text-muted hover:text-accent" href={REPO_URL} target="_blank" rel="noopener noreferrer">Source</a>
			</p>
		</div>
	</div>
</footer>
