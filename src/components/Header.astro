---
import { REPO_URL, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SiteLogo from './SiteLogo.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-50 border-b border-border bg-[var(--header-bg)] backdrop-blur-md">
	<nav class="shell flex h-16 items-center justify-between gap-4 py-0">
		<div class="flex items-center gap-3">
			<a class="inline-flex items-center transition hover:opacity-90" href="/" aria-label={`${SITE_TITLE} home`}>
				<SiteLogo />
			</a>
			<div class="hidden lg:flex items-center gap-2 pl-3 border-l border-border">
				<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full font-mono text-[0.72rem] bg-bg-subtle text-text-muted border border-border">
					<span class="h-1.5 w-1.5 rounded-full bg-accent animate-pulse"></span>
					Personal Engineering Journal
				</span>
			</div>
		</div>

		<div class="flex items-center gap-2 sm:gap-4">
			<div class="flex items-center gap-1 sm:gap-2">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/blog">Blog</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
				<HeaderLink href="/subscribe">RSS</HeaderLink>
			</div>
			<div class="h-4 w-px bg-border hidden sm:block"></div>
			<ThemeToggle />
		</div>
	</nav>
</header>
