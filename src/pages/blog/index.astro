---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import JsonLd from '../../components/JsonLd.astro';
import Pagination from '../../components/Pagination.astro';
import PostCard from '../../components/PostCard.astro';
import SeriesFilter from '../../components/SeriesFilter.astro';
import { POSTS_PER_PAGE } from '../../consts';
import { blogJsonLd, graphJsonLd } from '../../utils/seo';
import { getSortedPosts, paginatePosts } from '../../utils/blog';

const posts = await getSortedPosts();
const pagination = paginatePosts(posts, 1, POSTS_PER_PAGE);
const description =
	'Technical write-ups on building software in public — architecture, CI, agents, and lessons from the repos I ship.';
const schema = graphJsonLd(blogJsonLd(Astro.site));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Blog" description={description} />
		<JsonLd schema={schema} />
		{
			pagination.totalPages > 1 && (
				<link rel="next" href="/blog/page/2/" />
			)
		}
	</head>
	<body class="relative overflow-x-hidden">
		<!-- Subdued ambient warm radial halo -->
		<div
			class="pointer-events-none fixed top-0 left-1/2 -z-10 h-[400px] w-[800px] -translate-x-1/2 rounded-full bg-accent/5 blur-[130px]"
			aria-hidden="true"
		></div>

		<Header />
		<main class="layout-archive py-10 md:py-16">
			<section class="mb-8 border-b border-border pb-6">
				<p class="eyebrow">// Dispatches &amp; Engineering Journal</p>
				<h1 class="font-serif text-3xl md:text-4xl font-normal text-text mt-1">Blog Archive</h1>
				<p class="lead mt-2">
					Technical write-ups on building software in public — architecture, CI, agents, and lessons from the repos I ship.
				</p>
			</section>

			<SeriesFilter />

			<ul class="post-grid">
				{pagination.items.map((post) => <PostCard post={post} />)}
			</ul>

			<Pagination
				currentPage={pagination.currentPage}
				totalPages={pagination.totalPages}
				basePath="/blog"
			/>
		</main>
		<Footer />
	</body>
</html>
