---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/JsonLd.astro';
import PartTag from '../components/PartTag.astro';
import PostCard from '../components/PostCard.astro';
import { BLOG_SERIES, RSS_FEED_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getSortedPosts } from '../utils/blog';
import { graphJsonLd, websiteJsonLd } from '../utils/seo';

const allPosts = await getSortedPosts();
const [featuredPost, ...recentPosts] = allPosts;
const schema = graphJsonLd(websiteJsonLd(Astro.site));

const seriesList = Object.entries(BLOG_SERIES).map(([slug, meta]) => ({
	slug,
	...meta,
	count: allPosts.filter((p) => p.data.series === slug).length,
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<JsonLd schema={schema} />
	</head>
	<body class="relative overflow-x-hidden">
		<!-- Subdued ambient warm radial halo from Stitch design system -->
		<div
			class="pointer-events-none fixed top-0 left-1/2 -z-10 h-[500px] w-[900px] -translate-x-1/2 rounded-full bg-accent/5 blur-[130px]"
			aria-hidden="true"
		></div>

		<Header />

		<main class="shell py-10 md:py-16 space-y-16 md:space-y-24">
			<!-- 1. Hero Section: Editorial Header -->
			<section class="relative max-w-4xl pt-2">
				<div class="mb-5 flex flex-wrap items-center gap-3">
					<span class="eyebrow">// Engineering Log &amp; Systems Lab</span>
					<span class="text-text-muted">&bull;</span>
					<span class="inline-flex items-center gap-1.5 font-mono text-xs text-text-muted">
						<span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
						Building in public
					</span>
				</div>

				<h1 class="mb-6 max-w-3xl font-serif text-[clamp(2.4rem,5.5vw,3.6rem)] font-normal leading-[1.15] tracking-tight text-text">
					Documenting the build, <span class="italic text-accent">one commit</span> at a time.
				</h1>

				<p class="lead max-w-2xl text-[1.15rem] leading-relaxed text-text-muted">
					Notes, experiments, and post-mortems from building software in public. Focusing on
					local AI orchestration, distributed data pipelines, and reproducible CI workflows.
				</p>

				<!-- Craft Metrics Strip -->
				<div class="my-8 grid max-w-xl grid-cols-3 gap-4 border-y border-border py-4 font-mono">
					<div>
						<div class="font-serif text-2xl font-semibold text-accent">3</div>
						<div class="text-[0.72rem] tracking-wider text-text-muted uppercase">Deep Series</div>
					</div>
					<div>
						<div class="font-serif text-2xl font-semibold text-text">100%</div>
						<div class="text-[0.72rem] tracking-wider text-text-muted uppercase">Open Source</div>
					</div>
					<div>
						<div class="font-serif text-2xl font-semibold text-tertiary">RSS</div>
						<div class="text-[0.72rem] tracking-wider text-text-muted uppercase">Zero Trackers</div>
					</div>
				</div>

				<!-- Action Row -->
				<div class="flex flex-wrap items-center gap-3">
					<a class="btn btn-primary" href="/blog">
						<span>Explore Blog Archive</span>
						<span aria-hidden="true">&rarr;</span>
					</a>
					<a class="btn" href="#series">
						<span>View Featured Series</span>
					</a>
					<a class="btn-outline" href="/subscribe">
						<span>RSS Feed</span>
					</a>
				</div>
			</section>

			<!-- 2. Featured Lead Article Bento Card -->
			{featuredPost && (
				<section class="space-y-4">
					<div class="flex items-baseline justify-between border-b border-border pb-3">
						<div class="flex items-center gap-2">
							<span class="font-mono text-xs font-semibold tracking-widest text-accent uppercase">// Latest Dispatch</span>
						</div>
						<a class="font-mono text-xs text-text-muted transition hover:text-accent" href="/blog">
							View all posts &rarr;
						</a>
					</div>

					<article class="amber-glow grid grid-cols-1 gap-6 rounded-theme border border-border bg-bg-elevated p-6 shadow-card transition-all duration-200 md:grid-cols-12 md:p-8">
						<div class="space-y-4 md:col-span-7">
							<div class="flex flex-wrap items-center gap-2">
								{featuredPost.data.series && (
									<span class="tag-series">
										#{BLOG_SERIES[featuredPost.data.series as keyof typeof BLOG_SERIES]?.title ?? featuredPost.data.series}
									</span>
								)}
								<span class="font-mono text-xs text-text-muted">
									<FormattedDate date={featuredPost.data.pubDate} />
								</span>
								{featuredPost.data.seriesPart && (
									<PartTag part={featuredPost.data.seriesPart} />
								)}
							</div>

							<h2 class="font-serif text-2xl md:text-3xl font-medium leading-tight text-text">
								<a class="text-inherit no-underline transition hover:text-accent" href={`/blog/${featuredPost.id}/`}>
									{featuredPost.data.title}
								</a>
							</h2>

							<p class="text-[1.02rem] leading-relaxed text-text-muted">
								{featuredPost.data.description}
							</p>

							<div class="pt-2">
								<a
									class="inline-flex items-center gap-2 font-mono text-sm font-semibold text-accent no-underline transition hover:underline"
									href={`/blog/${featuredPost.id}/`}
								>
									<span>Read full article</span>
									<span aria-hidden="true">&rarr;</span>
								</a>
							</div>
						</div>

						<!-- Code Preview / Architecture Callout Block -->
						<div class="flex flex-col justify-between rounded border border-border bg-code-bg p-4 font-mono text-xs md:col-span-5">
							<div class="mb-3 flex items-center justify-between border-b border-border pb-2 text-[0.75rem] text-text-muted">
								<div class="flex items-center gap-1.5">
									<span class="h-2 w-2 rounded-full bg-accent/70"></span>
									<span class="font-mono font-medium text-text">{featuredPost.id}.md</span>
								</div>
								<span class="text-[0.7rem] uppercase tracking-wider text-accent">Technical Log</span>
							</div>
							<div class="space-y-1.5 overflow-x-auto text-[0.8rem] leading-relaxed text-text-muted">
								<p><span class="text-accent">// Topic:</span> {featuredPost.data.series ?? 'Architecture'}</p>
								<p><span class="text-tertiary">git log:</span> <span class="text-text">HEAD~1..HEAD</span></p>
								<p><span class="text-tertiary">status:</span> <span class="text-accent font-medium">Shipped &amp; Documented</span></p>
								<p class="pt-2 text-[0.78rem] text-text-muted/80 italic">
									"{featuredPost.data.description.slice(0, 100)}..."
								</p>
							</div>
							<div class="mt-4 pt-2 border-t border-border flex items-center justify-between text-[0.72rem] text-text-muted">
								<span>Format: Markdown / MDX</span>
								<span class="text-accent">Astro 6.4</span>
							</div>
						</div>
					</article>
				</section>
			)}

			<!-- 3. Recent Dispatches Grid -->
			{recentPosts.length > 0 && (
				<section class="space-y-6">
					<div class="flex items-baseline justify-between border-b border-border pb-3">
						<h2 class="font-serif text-2xl font-medium text-text">Recent Articles</h2>
						<a class="font-mono text-xs text-accent transition hover:underline" href="/blog">
							Browse archive ({allPosts.length} posts) &rarr;
						</a>
					</div>

					<ul class="post-grid">
						{recentPosts.slice(0, 4).map((post) => (
							<PostCard post={post} />
						))}
					</ul>
				</section>
			)}

			<!-- 4. Featured Series Section (Anchor: #series) -->
			<section class="space-y-6 scroll-mt-20" id="series">
				<div class="border-b border-border pb-3">
					<span class="eyebrow">// Systems Engineering In-Depth</span>
					<h2 class="mt-1 font-serif text-2xl md:text-3xl font-medium text-text">Featured Series</h2>
					<p class="mt-1 text-sm text-text-muted">
						Multi-part explorations tackling specific engineering challenges from architecture to production.
					</p>
				</div>

				<div class="grid grid-cols-1 gap-5 md:grid-cols-3">
					{seriesList.map((series) => (
						<div class="series-card group">
							<div class="space-y-3">
								<div class="flex items-center justify-between">
									<span class="font-mono text-xs font-semibold text-accent">#{series.slug}</span>
									<span class="font-mono text-[0.72rem] text-text-muted">
										{series.count} {series.count === 1 ? 'part' : 'parts'}
									</span>
								</div>

								<h3 class="font-serif text-xl font-medium text-text group-hover:text-accent transition-colors">
									<a class="text-inherit no-underline" href={`/blog/series/${series.slug}/`}>
										{series.title}
									</a>
								</h3>

								<p class="text-sm leading-relaxed text-text-muted">
									{series.description}
								</p>
							</div>

							<div class="mt-6 pt-4 border-t border-border flex items-center justify-between font-mono text-xs">
								<a
									class="inline-flex items-center gap-1 text-accent no-underline hover:underline"
									href={`/blog/series/${series.slug}/`}
								>
									<span>Read series</span>
									<span aria-hidden="true">&rarr;</span>
								</a>
								{series.repoUrl && (
									<a
										class="text-text-muted no-underline hover:text-text transition"
										href={series.repoUrl}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={`GitHub repo for ${series.title}`}
									>
										GitHub &nearr;
									</a>
								)}
							</div>
						</div>
					))}
				</div>
			</section>

			<!-- 5. Dispatch / RSS Subscription Banner -->
			<section class="rounded-theme border border-border bg-bg-elevated p-8 shadow-card amber-glow">
				<div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:items-center">
					<div class="space-y-2 md:col-span-7">
						<span class="eyebrow">// Syndication</span>
						<h2 class="font-serif text-2xl font-medium text-text">Stay updated via open standards</h2>
						<p class="text-sm text-text-muted leading-relaxed max-w-xl">
							No algorithmic feeds, tracking pixels, or paywalls. Subscribe to the full-text RSS feed in
							your favorite reader (NetNewsWire, Feedly, Reeder, Readwise) to receive new essays the moment they ship.
						</p>
					</div>

					<div class="space-y-3 md:col-span-5">
						<div class="flex items-center gap-2 rounded-theme border border-border bg-code-bg p-2 font-mono text-xs">
							<input
								type="text"
								readonly
								value={RSS_FEED_URL}
								class="w-full bg-transparent px-2 text-text outline-none selection:bg-accent selection:text-accent-on"
								aria-label="RSS Feed URL"
								id="rss-input"
							/>
							<button
								type="button"
								class="shrink-0 rounded bg-bg-subtle px-3 py-1 text-xs text-text transition hover:bg-accent hover:text-accent-on"
								onclick="navigator.clipboard.writeText(document.getElementById('rss-input').value); this.innerText = 'Copied!';"
							>
								Copy URL
							</button>
						</div>
						<div class="flex items-center justify-between text-xs text-text-muted font-mono">
							<a class="text-accent underline" href="/subscribe">Detailed instructions &amp; feeds &rarr;</a>
							<a class="text-text-muted hover:text-text" href="/rss.xml" target="_blank">Direct XML link &nearr;</a>
						</div>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>
